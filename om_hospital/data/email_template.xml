<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_appointment" model="mail.template">
        <field name="name">Appointment Confirmation</field>
        <field name="model_id" ref="om_hospital.model_hospital_appointment"/>
        <field name="subject">Appointment {{ object.reference }} confirmed</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.patient_id.name or ''"/>,</p>
                <p>Your appointment <b><t t-out="object.reference or ''"/></b>
                   on <t t-out="object.date_appointment or ''"/> is confirmed.</p>
                <p>Thank you!</p>
            </div>
        </field>
    </record>
</odoo>
