<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <!-- Tree View (List) -->
     <record id="view_hospital_appointment_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.tree</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <tree string="Appointments">
                <field name="reference" readonly="True"/>
                <field name="patient_id"/>
                <field name="create_uid" groups="om_hospital.group_hospital_doctors"/>
                <field name="date_appointment"/>
            </tree>
        </field>
     </record>
     <!-- From View (List) -->
     <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
             <header>
                    <button name="action_confirm" type="object" string="Confirmed" invisible="state!= 'draft'" class="oe_highlight"/>
                    <button name="action_ongoing" type="object" string="Ongoing" invisible="state!= 'confirmed'" class="oe_highlight"/>
                    <button name="action_done" type="object" string="Done" invisible="state!= 'ongoing'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'done'"/>
                    <button name="action_send_email" string="Send Email" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,ongoing,done"/>
            </header>
            <sheet>
              <group>
                  <field name="reference" readonly="True"/>
                  <field name="patient_id"/>
                   <field name="date_of_birth"/>
                  <field name="date_appointment"/>
                  <field name="note"/>
                  <field name="total_qty"/>   
                   <field name="create_uid" groups="om_hospital.group_hospital_doctors"/>          
              </group>
              <notebook>
                 <page name="appointment_lines" string="Lines">
                     <field name="appointment_line_ids">
                         <tree editable="bottom">
                             <field name="product_id"/>
                             <field name="qty"/>            
                         </tree>
                     </field>        
                 </page>
              </notebook> 
            </sheet>
              <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
     </record>
      <!-- Search View (List) -->
      <record id="view_hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search string="Appointments">
                <field name="reference" filter_domain="['|', ('reference','ilike',self), ('patient_id','ilike',self)]"/>
                <group expand="1" string="Group By">
                    <filter string="Patient" name="group_by_patient" context="{'group_by' : 'patient_id'}"/>
                </group>
                <searchpanel>
                    <field name="patient_id" string="Patient" enable_counters="1"></field>
                </searchpanel>
            </search>
        </field>
     </record>

     <!-- Action -->
     <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">tree,form</field>
     </record>
</odoo>