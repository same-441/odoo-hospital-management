<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View (List) -->
    <record id="view_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hospital.patient.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <tree decoration-warning="is_minor == True" decoration-success="is_minor == False" decoration-bf="is_minor == True" string="Patients">
                <field name="name" />
                <field name="date_of_birth" optional="show" />
                <field name="email"/>
                <field name="gender" optional="hide" />
                 <field name="is_minor" />
            </tree>
        </field>
    </record>
    <!-- From View (List) -->
    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patients">
                <!-- ADD HEADER HERE -->
                <header>
                <button name="action_open_complaint"
                    string="Add Complaint"
                    type="object"
                    class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="date_of_birth" />
                        <field name="email" />
                        <field name="is_minor" widget="boolean_toggle"/>
                        <field name="guardian_name" invisible="not is_minor" required="is_minor" />
                        <field name="gender" />
                        <field name="tag_ids" widget="many2many_tags" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
    <!-- Search View (List) -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" />
                <field name="date_of_birth" />
                <field name="gender" />
                <field name="guardian_name" />
                <filter string="Male" name="male_patients" domain="[('gender','=','male')]" />
                <!--<separator/>-->
                <filter string="Female" name="female_patients" domain="[('gender','=','female')]" />
                <group expand="1" string="Group By">
                    <filter string="Gender" name="group_by_gender" context="{'group_by' : 'gender'}" />
                </group>
                <searchpanel>
                    <field name="gender" string="Gender" enable_counters="1"></field>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hospital_patient_search" />
        <field name="context">{'search_default_male_patients': 1}</field>
    </record>
</odoo>